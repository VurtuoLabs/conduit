<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Conduit User</label>
    <description
  >Grants access to the Conduit Apex entry points and to the Conduit Case Agent. Record and field visibility continue to come from the user's own profile and permission sets, because every Conduit query runs in USER_MODE.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <!-- Without this, an employee agent is published and active but invisible in the
         Agentforce panel, and previewing it fails with "Invalid user ID provided on start
         session". agentName must match developer_name in the .agent config block exactly. -->
    <agentAccesses>
        <agentName>Conduit_Case_Agent</agentName>
        <enabled>true</enabled>
    </agentAccesses>
    <classAccesses>
        <apexClass>ConduitAgentClient</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ConduitAgentSettings</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ConduitContext</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ConduitCaseContext</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ConduitPrompt</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ConduitCaseBriefController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
